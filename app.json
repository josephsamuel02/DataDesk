{
  "expo": {
    "name": "Data Desk",
    "slug": "data-desk",
    "version": "1.0.0",
    "scheme": "datadesk",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.datadesk.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E7F8EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.datadesk.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#16A34A",
          "sounds": []
        }
      ],
      [
        "expo-secure-store"
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Data Desk needs access to your photos to upload a profile picture."
        }
      ]
    ]
  }
}
